			#clock-cells = <0x00>;
			clock-frequency = <0x17d7840>;
			phandle = <0x06>;
		};
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyS0,115200 earlycon=uart8250,mmio32,0xd0012000 root=/dev/sda1 rootfstype=ext2 rootwait";
		linux,initrd-start = <0x04000000>;
		linux,initrd-end = <0x4000000>;  /* set per initrd by make-boot-files.py / mkdrobokernel */
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x80000000>;
	};
