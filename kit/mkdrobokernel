#!/bin/sh
# mkdrobokernel [VERSION] : build the Drobo 5N boot files in /boot/drobo from Debian's kernel and initrd.
#
# U-Boot (2009.08, Drobo AMP build) can't boot a modern kernel directly. It loads these files from the
# eUSB stick (ext2) and runs `go 8000000`:
#   kernel.0 .. kernel.4  gzip "standalone" uImages. Together they are stub.bin + the uncompressed Image,
#                         split into 7 MiB pieces, because bootm won't unpack more than 8 MB per image.
#                         Piece N unpacks to 0x8000000 + N*0x700000; unused pieces are 4-byte dummies.
#   initrd                hard link to Debian's initrd
#   drobo5n.dtb           the template DTB with /chosen linux,initrd-end set for this initrd
# The stub copies the Image to 0x1208000 (nothing may be written below 16 MB on this board) and enters it.
#
# Builds into /boot/drobo/new, checks it, then moves the current set to /boot/drobo/prev and sets
# /boot/drobo/trial so U-Boot tries the new set once (see drobo-boot-ok).
# Run as root. Debian runs it from /etc/kernel/postinst.d and /etc/initramfs/post-update.d.
set -eu
LIB=/usr/local/lib/drobo
OUT=/boot/drobo
NPARTS=5
CHUNK=7340032            # 0x700000
SLOT=8388608             # U-Boot loads compressed piece N at 0xB000000 + N*0x800000 (above the unpacked kernel)
LOADBASE=134217728       # 0x8000000
INITRD_AT=67108864       # 0x4000000 (DTB at 0x3f00000)
INITRD_MAX=67108864      # initrd must end below 0x8000000

v=${1:-$(uname -r)}
case "$v" in *armmp-lpae*) ;; *) echo "mkdrobokernel: skipping $v (not armmp-lpae)"; exit 0;; esac
vmlinuz=/boot/vmlinuz-$v
initrd=/boot/initrd.img-$v
for f in "$vmlinuz" "$initrd" "$LIB/stub.bin" "$LIB/drobo5n.dtb"; do
  [ -f "$f" ] || { echo "mkdrobokernel: missing $f" >&2; exit 1; }
done

le32() {  # print a 32-bit number as 4 little-endian bytes
  printf "$(printf '\\%03o\\%03o\\%03o\\%03o' $(($1 & 255)) $((($1 >> 8) & 255)) $((($1 >> 16) & 255)) $((($1 >> 24) & 255)))"
}

new=$OUT/new
rm -rf "$new"
# The root is a 1 GB stick: refuse to build unless a new set (about 10 MB, initrd hard-linked) leaves headroom.
MIN_FREE_KB=${MIN_FREE_KB:-51200}
free=$(df -Pk "$OUT" | awk 'NR == 2 { print $4 }')
[ "$free" -ge "$MIN_FREE_KB" ] || { echo "mkdrobokernel: only ${free} KB free on $OUT, need $MIN_FREE_KB; keeping the current boot files" >&2; exit 1; }
mkdir -p "$new"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

# 1. The uncompressed Image: the zImage carries one xz stream.
# The xz magic also appears earlier by chance, so try each match until one decodes.
ilen=0
for off in $(LC_ALL=C grep -abo "$(printf '\3757zXZ')" "$vmlinuz" | cut -d: -f1); do
  if tail -c +$((off + 1)) "$vmlinuz" | xz -dc --single-stream > "$tmp/Image" 2>/dev/null; then
    ilen=$(stat -c %s "$tmp/Image"); break
  fi
done
[ "$ilen" -gt 4000000 ] || { echo "mkdrobokernel: Image too small ($ilen)" >&2; exit 1; }

# 2. stub + Image, with the Image length patched in after the DRBOLEN0 marker.
cp "$LIB/stub.bin" "$tmp/blob"
moff=$(LC_ALL=C grep -abo DRBOLEN0 "$tmp/blob" | head -1 | cut -d: -f1)
le32 "$ilen" | dd of="$tmp/blob" bs=1 seek=$((moff + 8)) conv=notrunc status=none
cat "$tmp/Image" >> "$tmp/blob"
blen=$(stat -c %s "$tmp/blob")
[ "$blen" -le $((NPARTS * CHUNK)) ] || { echo "mkdrobokernel: kernel too big ($blen > $NPARTS pieces)" >&2; exit 1; }

# 3. Pieces.
( cd "$tmp" && split -b $CHUNK -d -a 1 blob part )
i=0
while [ $i -lt $NPARTS ]; do
  addr=$(printf 0x%x $((LOADBASE + i * CHUNK)))
  if [ -f "$tmp/part$i" ]; then
    gzip -9 -n -c "$tmp/part$i" > "$tmp/part$i.gz"
  else
    printf '\0\0\0\0' | gzip -9 -n -c > "$tmp/part$i.gz"
  fi
  mkimage -A arm -O linux -T standalone -C gzip -a $addr -e $addr -n "drobo-$v-$i" \
    -d "$tmp/part$i.gz" "$new/kernel.$i" > /dev/null
  [ "$(stat -c %s "$new/kernel.$i")" -lt $((SLOT - 4096)) ] || { echo "mkdrobokernel: piece $i too big" >&2; exit 1; }
  i=$((i + 1))
done

# 4. initrd and DTB.
isz=$(stat -c %s "$initrd")
[ "$isz" -lt $INITRD_MAX ] || { echo "mkdrobokernel: initrd too big ($isz)" >&2; exit 1; }
ln -f "$initrd" "$new/initrd"
cp "$LIB/drobo5n.dtb" "$new/drobo5n.dtb"
fdtput -t x "$new/drobo5n.dtb" /chosen linux,initrd-start $(printf %x $INITRD_AT)
fdtput -t x "$new/drobo5n.dtb" /chosen linux,initrd-end $(printf %x $((INITRD_AT + isz)))
# Root by UUID (a disk in a bay can take sda), panic=10 so a failed boot resets instead of
# waiting at a shell only the UART can reach, fsck.repair=yes so an unclean ext2 root gets fixed.
# ROOT_UUID / ROOT_FSTYPE override the running root (used once, to boot a new root on the mSATA).
uuid=${ROOT_UUID:-$(findmnt -no UUID /)}; fstype=${ROOT_FSTYPE:-$(findmnt -no FSTYPE /)}
[ -n "$uuid" ] || { echo "mkdrobokernel: can't find the root UUID" >&2; exit 1; }
args=$(fdtget "$new/drobo5n.dtb" /chosen bootargs | sed -E 's/(^| )(root|rootfstype|panic|fsck\.repair)=[^ ]*//g; s/^ +//')
fdtput -t s "$new/drobo5n.dtb" /chosen bootargs "$args root=UUID=$uuid rootfstype=$fstype panic=10 fsck.repair=yes"
# A set id, so drobo-boot-ok can tell which set U-Boot actually booted (current or prev).
setid="$(date +%Y%m%d%H%M%S)-$v"
fdtput -t s "$new/drobo5n.dtb" /chosen drobo,set-id "$setid"
echo "$setid" > "$new/SETID"

# 5. Check: unpacking the pieces again must give back the blob exactly.
i=0; : > "$tmp/check"
while [ $i -lt $NPARTS ]; do
  [ -f "$tmp/part$i" ] && tail -c +65 "$new/kernel.$i" | gzip -dc >> "$tmp/check"
  i=$((i + 1))
done
cmp -s "$tmp/check" "$tmp/blob" || { echo "mkdrobokernel: pieces don't match" >&2; exit 1; }
echo "$v" > "$new/VERSION"

# 6. Swap in: new -> current. Files U-Boot reads live directly in /boot/drobo.
# The current set only becomes prev if it has booted (drobo-boot-ok writes $OUT/booted-ok after a good boot).
# Otherwise (e.g. the hook runs twice in one upgrade) it is simply replaced, so prev is always a set that booted.
SET="kernel.0 kernel.1 kernel.2 kernel.3 kernel.4 initrd drobo5n.dtb VERSION SETID"
if [ -f "$OUT/booted-ok" ] && (cd "$OUT" && md5sum --status -c booted-ok 2>/dev/null); then
  rm -rf "$OUT/prev"; mkdir -p "$OUT/prev"
  for f in $SET; do [ -e "$OUT/$f" ] && mv "$OUT/$f" "$OUT/prev/$f"; done
  rm -f "$OUT/booted-ok"
  echo "mkdrobokernel: previous set (booted) kept in $OUT/prev"
else
  for f in $SET; do rm -f "$OUT/$f"; done
  echo "mkdrobokernel: current set never booted; replaced it and left $OUT/prev alone"
fi
mv "$new"/* "$OUT/"; rmdir "$new"
# The trial flag is a U-Boot script that sets dbtrialid. U-Boot boots this set once (saving dbtry=<id>);
# if it finds the flag again with dbtry already equal to the id, that try didn't come up and it boots prev.
# drobo-boot-ok removes the flag after a good boot.
printf 'setenv dbtrialid %s\n' "$setid" > "$tmp/trial.txt"
mkimage -A arm -O linux -T script -C none -n drobo-trial -d "$tmp/trial.txt" "$OUT/trial" > /dev/null
sync
echo "mkdrobokernel: $v ready ($ilen byte Image in $(ls "$OUT"/kernel.? | wc -l) pieces, initrd $isz bytes)"
[ -x /usr/local/sbin/drobo-boot-sync ] && { /usr/local/sbin/drobo-boot-sync || echo "mkdrobokernel: WARNING: copy to the SSD boot partition failed" >&2; }
